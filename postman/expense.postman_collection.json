{
  "info": {
    "name": "Expense Tracker – Expense",
    "_postman_id": "expense-collection-001",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userId",  "value": "user1" }
  ],
  "item": [
    {
      "name": "Record Expense (manual)",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/finance/expense?userId={{userId}}&amount=350&category=FOOD_DINING&description=Lunch+at+Haldiram",
          "host": ["{{baseUrl}}"],
          "path": ["api", "finance", "expense"],
          "query": [
            { "key": "userId",      "value": "{{userId}}" },
            { "key": "amount",      "value": "350" },
            { "key": "category",    "value": "FOOD_DINING",
              "description": "FOOD_DINING | GROCERIES | TRANSPORTATION | UTILITIES | ENTERTAINMENT | SHOPPING | HEALTHCARE | INSURANCE | SUBSCRIPTION | INVESTMENT | SAVINGS | OTHER" },
            { "key": "description", "value": "Lunch at Haldiram" }
          ]
        }
      }
    },
    {
      "name": "Parse SMS Expense",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "text/plain" }
        ],
        "body": {
          "mode": "raw",
          "raw": "Rs.1500.00 debited from A/c XXXX1234 at Amazon on 04-Apr-2026. UPI Ref: 123456789"
        },
        "url": {
          "raw": "{{baseUrl}}/api/finance/expense/sms?userId={{userId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "finance", "expense", "sms"],
          "query": [
            { "key": "userId", "value": "{{userId}}" }
          ]
        }
      }
    },
    {
      "name": "Monthly Spending Summary",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/finance/expense/summary?userId={{userId}}&year=2026&month=4",
          "host": ["{{baseUrl}}"],
          "path": ["api", "finance", "expense", "summary"],
          "query": [
            { "key": "userId", "value": "{{userId}}" },
            { "key": "year",   "value": "2026" },
            { "key": "month",  "value": "4" }
          ]
        }
      }
    },
    {
      "name": "Spending Trend (last N months)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/finance/expense/trend?userId={{userId}}&months=6",
          "host": ["{{baseUrl}}"],
          "path": ["api", "finance", "expense", "trend"],
          "query": [
            { "key": "userId", "value": "{{userId}}" },
            { "key": "months", "value": "6" }
          ]
        }
      }
    },
    {
      "name": "Expenses by Date Range (paginated)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/finance/expense/range?userId={{userId}}&startDate=2026-01-01&endDate=2026-04-04&page=0&size=20",
          "host": ["{{baseUrl}}"],
          "path": ["api", "finance", "expense", "range"],
          "query": [
            { "key": "userId",    "value": "{{userId}}" },
            { "key": "startDate", "value": "2026-01-01" },
            { "key": "endDate",   "value": "2026-04-04" },
            { "key": "page",      "value": "0" },
            { "key": "size",      "value": "20" }
          ]
        }
      }
    }
  ]
}
