{
  "info": {
    "name": "Expense Tracker – Documents",
    "_postman_id": "document-collection-001",
    "description": "Upload and parse bank/MF/credit-card statements. The document API extracts text and returns neutral parse records; expense import is a separate finance operation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",    "value": "http://localhost:8080" },
    { "key": "documentId", "value": "1" }
  ],
  "item": [
    {
      "name": "Upload PDF Statement",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "",
              "description": "Bank / MF / Demat / Credit Card PDF"
            },
            {
              "key": "password",
              "type": "text",
              "value": "",
              "description": "Optional – only for password-protected PDFs"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/documents/upload",
          "host": ["{{baseUrl}}"],
          "path": ["api", "documents", "upload"]
        },
        "description": "Stores the PDF, extracts text, auto-detects institution, and records neutral parsed transaction count. This does not save Expense records."
      }
    },
    {
      "name": "Parse PDF Without Saving",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "",
              "description": "Bank / MF / Demat / Credit Card PDF"
            },
            {
              "key": "password",
              "type": "text",
              "value": "",
              "description": "Optional - only for password-protected PDFs"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/documents/parse",
          "host": ["{{baseUrl}}"],
          "path": ["api", "documents", "parse"]
        },
        "description": "Extracts text and returns ParsedDocument with neutral transactions. No document metadata, expenses, or budgets are saved."
      }
    },
    {
      "name": "List All Uploaded Documents",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/documents",
          "host": ["{{baseUrl}}"],
          "path": ["api", "documents"]
        }
      }
    },
    {
      "name": "Get Document by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/documents/{{documentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "documents", "{{documentId}}"]
        }
      }
    },
    {
      "name": "Get Document Parse Result",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/documents/{{documentId}}/parse-result",
          "host": ["{{baseUrl}}"],
          "path": ["api", "documents", "{{documentId}}", "parse-result"]
        }
      }
    },
    {
      "name": "Import Parsed Document Expenses",
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/finance/expense/import/document/{{documentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "finance", "expense", "import", "document", "{{documentId}}"]
        },
        "description": "Explicit expense-module operation that converts neutral parsed transactions into Expense records and updates budgets."
      }
    }
  ]
}
